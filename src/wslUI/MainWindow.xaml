<Window x:Class="wslUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:wslUI.ViewModels"
        xmlns:views="clr-namespace:wslUI.Views"
        Title="wslUI" Icon="Assets/app.ico"
        Width="1320" Height="860" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DistrosPageViewModel}"><views:DistrosView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstallPageViewModel}"><views:InstallView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupPageViewModel}"><views:BackupView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DisksPageViewModel}"><views:DisksView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:WslConfigPageViewModel}"><views:ConfigEditorView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DistroConfigPageViewModel}"><views:ConfigEditorView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConsolePageViewModel}"><views:ConsoleView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemPageViewModel}"><views:SystemView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="300" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="LogRow" Height="170" MinHeight="60" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <DockPanel Grid.Row="0" Grid.RowSpan="3" Margin="8,8,0,8">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,6,0,18">
                <Image Source="Assets/app.ico" Width="26" Height="26" />
                <TextBlock Text="wslUI" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding WslVersion}" Style="{StaticResource Hint}" Margin="12,8,8,4" />
            <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2,6">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Width="22" />
                            <TextBlock Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Page -->
        <ContentControl Grid.Row="0" Grid.Column="1" Content="{Binding SelectedPage}" Margin="16,16,20,8" Focusable="False" />

        <GridSplitter Grid.Row="1" Grid.Column="1" Height="6" HorizontalAlignment="Stretch" Background="Transparent"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS" />

        <!-- Command log -->
        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}" Padding="10,6,10,10" Margin="16,0,20,4">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="&#xE756;" Style="{StaticResource Icon}" FontSize="13" />
                    <TextBlock Text="Command log" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="— every wsl.exe command wslUI runs, with its output" Style="{StaticResource Hint}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearLogCommand}" Padding="10,2" HorizontalAlignment="Right" />
                </DockPanel>
                <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" Style="{StaticResource Mono}" TextChanged="LogBox_TextChanged" />
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <DockPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="18,2,20,8" LastChildFill="False">
            <ProgressBar DockPanel.Dock="Left" Width="90" Height="4" IsIndeterminate="{Binding IsBusy}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Left" Content="Cancel" Command="{Binding CancelAllCommand}" Margin="10,0,0,0" Padding="10,1"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding VmInfo}" VerticalAlignment="Center" Style="{StaticResource Hint}" FontSize="12.5" />
        </DockPanel>
    </Grid>
</Window>
