<Window x:Class="wslUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:wslUI.ViewModels"
        xmlns:views="clr-namespace:wslUI.Views"
        Title="wslUI" Icon="Assets/app.ico"
        Width="1360" Height="880" MinWidth="1080" MinHeight="640"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}" FontSize="13.5"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DistrosPageViewModel}"><views:DistrosView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstallPageViewModel}"><views:InstallView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupPageViewModel}"><views:BackupView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DisksPageViewModel}"><views:DisksView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:WslConfigPageViewModel}"><views:ConfigEditorView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DistroConfigPageViewModel}"><views:ConfigEditorView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConsolePageViewModel}"><views:ConsoleView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemPageViewModel}"><views:SystemView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar ================= -->
        <Border Background="{StaticResource NavBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,18,0,22">
                    <Image Source="Assets/app.ico" Width="30" Height="30" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="wslUI" FontSize="17" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" />
                        <TextBlock Text="WSL control center" FontSize="11" Foreground="{StaticResource TextSubtleBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- VM status footer -->
                <Border DockPanel.Dock="Bottom" Margin="12,8,12,14" Padding="12,10" CornerRadius="8" Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextSubtleBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VmOnline}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold">
                                <Run Text="{Binding RunningCount, Mode=OneWay}" /><Run Text=" of " /><Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text=" running" />
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding VmInfo}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="16,4,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding WslVersion}" FontSize="11" Foreground="{StaticResource TextSubtleBrush}" Margin="16,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- Pages -->
                <ListBox ItemsSource="{Binding PagesView}" SelectedItem="{Binding SelectedPage}"
                         ItemContainerStyle="{StaticResource NavItem}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Navigation">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionLabel}" Margin="22,14,0,6" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding Title}">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="16" Width="22" />
                                <TextBlock Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ================= Content ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="300" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="LogRow" Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ContentControl Content="{Binding SelectedPage}" Margin="28,22,28,12" Focusable="False" />

            <GridSplitter x:Name="LogSplitter" Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="Transparent"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS"
                          Visibility="{Binding LogVisible, Converter={StaticResource BoolToVis}}" />

            <!-- Command log (collapsible) -->
            <Border Grid.Row="2" Background="{StaticResource NavBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    Visibility="{Binding LogVisible, Converter={StaticResource BoolToVis}}">
                <DockPanel Margin="20,8,20,10">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="&#xE756;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="Command log" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="Every wsl.exe command wslUI runs, with its output" Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Command="{Binding ClearLogCommand}" ToolTip="Clear log" AutomationProperties.Name="Clear log" Width="30" Height="28" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding ToggleLogCommand}" ToolTip="Hide log" AutomationProperties.Name="Hide log" Width="30" Height="28" />
                        </StackPanel>
                    </DockPanel>
                    <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" Style="{StaticResource Mono}" TextChanged="LogBox_TextChanged" />
                </DockPanel>
            </Border>

            <!-- Status bar -->
            <Border Grid.Row="3" Background="{StaticResource NavBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <DockPanel Margin="16,4,16,4" LastChildFill="True">
                    <Button DockPanel.Dock="Left" Command="{Binding ToggleLogCommand}" Cursor="Hand" Padding="8,3" Background="Transparent" BorderThickness="0"
                            ToolTip="Show or hide the command log" AutomationProperties.Name="Toggle command log">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE756;" Style="{StaticResource Icon}" FontSize="12" />
                            <TextBlock Text="Log" Margin="6,0,0,0" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <ProgressBar DockPanel.Dock="Left" Width="70" Height="3" IsIndeterminate="{Binding IsBusy}" Margin="12,0,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="12" Margin="10,0,0,0" Foreground="{StaticResource TextMutedBrush}" />
                    <Button DockPanel.Dock="Left" Content="Cancel" Command="{Binding CancelAllCommand}" Margin="10,0,0,0" Padding="10,1" FontSize="12"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding LastCommand}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource TextSubtleBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="16,0,0,0" HorizontalAlignment="Right" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
