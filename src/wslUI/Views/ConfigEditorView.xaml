<UserControl x:Class="wslUI.Views.ConfigEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:wslUI.Infrastructure">
    <DockPanel>
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" infra:Ui.ChildMargin="8,0,0,0">
                <Border Style="{StaticResource Pill}" Background="{StaticResource WarnSoftBrush}" Padding="10,4"
                        Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource WarnBrush}" />
                        <TextBlock Text="Unsaved changes" Margin="6,0,0,0" FontSize="12" Foreground="{StaticResource WarnBrush}" />
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding LoadCommand}" ToolTip="Reload from disk" AutomationProperties.Name="Reload" />
                <Button Style="{StaticResource IconTextButton}" infra:Ui.Icon="&#xE7E8;" Content="{Binding ApplyText}" Command="{Binding ApplyCommand}" />
                <Button Style="{StaticResource AccentIconTextButton}" infra:Ui.Icon="&#xE74E;" Content="Save" Command="{Binding SaveCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </DockPanel>

        <!-- Filter bar -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,14,0"
                        Visibility="{Binding IsDistroScoped, Converter={StaticResource BoolToVis}}">
                <ComboBox ItemsSource="{Binding Main.Distros}" SelectedItem="{Binding SelectedDistro}" MinWidth="220" AutomationProperties.Name="Distribution">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource BrandTile}" Content="{Binding Name}" Width="20" Height="20" FontSize="9" />
                                <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="14,0,0,0" MaxWidth="360" />
            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding ShowModifiedOnly}" VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock>Modified only (<Run Text="{Binding ModifiedCount, Mode=OneWay}" />)</TextBlock>
            </CheckBox>
            <Grid MaxWidth="420" HorizontalAlignment="Left">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,7,10,7" MinWidth="280" AutomationProperties.Name="Search settings" />
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Margin="12,0,0,0" Foreground="{StaticResource TextSubtleBrush}" IsHitTestVisible="False" />
                <TextBlock Text="Search settings…" Margin="35,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSubtleBrush}" IsHitTestVisible="False"
                           Visibility="{Binding SearchText, Converter={StaticResource InvBoolToVis}}" />
            </Grid>
        </DockPanel>

        <TabControl SelectedIndex="{Binding TabIndex}">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9E9;" Style="{StaticResource Icon}" FontSize="13" />
                        <TextBlock Text="Settings" Margin="8,0,0,0" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <ItemsControl ItemsSource="{Binding EntriesView}" Focusable="False">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,18,0,8">
                                            <Border Style="{StaticResource IconBadge}" Width="30" Height="30" Background="{StaticResource AccentSoftBrush}">
                                                <TextBlock Text="{Binding Name, Converter={StaticResource SectionInfo}, ConverterParameter=glyph}" Style="{StaticResource Icon}"
                                                           FontSize="14" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock FontSize="15" FontWeight="SemiBold">
                                                    <Run Text="{Binding Name, Mode=OneWay, Converter={StaticResource SectionInfo}}" />
                                                    <Run Text="{Binding Name, Mode=OneWay, StringFormat='  [{0}]'}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="Normal" Foreground="{StaticResource TextSubtleBrush}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Name, Converter={StaticResource SectionInfo}, ConverterParameter=hint}" Style="{StaticResource Hint}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}" BorderThickness="1" CornerRadius="8" Padding="16,11" Margin="0,0,0,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSet}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#5522C55E" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" MinWidth="320" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Key}" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" FontSize="13" />
                                                <Border Style="{StaticResource Pill}" Background="{StaticResource AccentSoftBrush}" Margin="8,0,0,0" Padding="6,0,6,1"
                                                        Visibility="{Binding IsSet, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="set" FontSize="10.5" Foreground="{StaticResource AccentBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" Margin="0,3,0,0" />
                                        </StackPanel>

                                        <!-- Choice: segmented control -->
                                        <ListBox Grid.Column="1" Style="{StaticResource Segmented}" ItemsSource="{Binding Choices}" SelectedItem="{Binding ChoiceValue}"
                                                 HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="{Binding Key}"
                                                 Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}" />
                                        <!-- Text / path -->
                                        <DockPanel Grid.Column="1" VerticalAlignment="Center" Width="320" HorizontalAlignment="Right"
                                                   Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}">
                                            <Button DockPanel.Dock="Right" Content="&#xE838;" FontFamily="{StaticResource IconFont}" Margin="6,0,0,0" Padding="10,6"
                                                    ToolTip="Browse…" AutomationProperties.Name="Browse"
                                                    Visibility="{Binding IsPath, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.BrowsePathCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Grid>
                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Key}" />
                                                <TextBlock Text="{Binding Placeholder}" Margin="11,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSubtleBrush}" IsHitTestVisible="False" FontSize="12.5"
                                                           Visibility="{Binding IsSet, Converter={StaticResource InvBoolToVis}}" />
                                            </Grid>
                                        </DockPanel>

                                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE7A7;" Margin="8,0,0,0"
                                                ToolTip="Reset to default (removes the key)" AutomationProperties.Name="Reset to default"
                                                IsEnabled="{Binding IsSet}"
                                                Command="{Binding DataContext.ResetEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE943;" Style="{StaticResource Icon}" FontSize="13" />
                        <TextBlock Text="Raw file" Margin="8,0,0,0" />
                    </StackPanel>
                </TabItem.Header>
                <DockPanel Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Top" Text="Edit the file directly. Comments and unknown keys are preserved when you switch back to Settings." Style="{StaticResource Hint}" Margin="0,0,0,8" />
                    <TextBox Text="{Binding RawText, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" FontSize="13"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Raw file contents" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
