<UserControl x:Class="wslUI.Views.DistrosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:wslUI.Infrastructure">
    <UserControl.Resources>
        <!-- Status dot colour by state -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Fill" Value="{StaticResource TextSubtleBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateKind}" Value="running"><Setter Property="Fill" Value="{StaticResource AccentBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding StateKind}" Value="busy"><Setter Property="Fill" Value="{StaticResource WarnBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatePill" TargetType="Border" BasedOn="{StaticResource Pill}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateKind}" Value="running"><Setter Property="Background" Value="{StaticResource AccentSoftBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding StateKind}" Value="busy"><Setter Property="Background" Value="{StaticResource WarnSoftBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StateText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateKind}" Value="running"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding StateKind}" Value="busy"><Setter Property="Foreground" Value="{StaticResource WarnBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Start/stop toggle for a row -->
        <Style x:Key="PowerButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Content" Value="&#xE768;" />
            <Setter Property="ToolTip" Value="Start" />
            <Setter Property="AutomationProperties.Name" Value="Start" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Content" Value="&#xE7E8;" />
                    <Setter Property="ToolTip" Value="Stop" />
                    <Setter Property="AutomationProperties.Name" Value="Stop" />
                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ColHeader" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" infra:Ui.ChildMargin="8,0,0,0">
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding RefreshCommand}" ToolTip="Refresh" AutomationProperties.Name="Refresh" />
                <Button Style="{StaticResource IconTextButton}" infra:Ui.Icon="&#xE7E8;" Content="Shut down WSL" Command="{Binding ShutdownAllCommand}"
                        ToolTip="Stop every distribution and the WSL 2 VM (wsl --shutdown)" />
                <Button Style="{StaticResource AccentIconTextButton}" infra:Ui.Icon="&#xE710;" Content="New distribution" Command="{Binding InstallNewCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Overview" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Live resource usage of the WSL 2 VM and each distribution." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </DockPanel>

        <!-- ===== Stat tiles ===== -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,-12,6">
            <!-- CPU -->
            <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="16,14">
                <StackPanel>
                    <DockPanel>
                        <Border Style="{StaticResource IconBadge}" Background="{StaticResource CpuSoftBrush}" Width="30" Height="30">
                            <TextBlock Text="&#xE950;" Style="{StaticResource Icon}" FontSize="15" Foreground="{StaticResource CpuBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="CPU" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Main.VmCpuText}" Style="{StaticResource StatValue}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding Main.VmCpuSubText}" Style="{StaticResource Hint}" />
                    <infra:Sparkline Values="{Binding Main.VmCpuHistory}" Stroke="{StaticResource CpuBrush}" Height="38" Margin="0,10,0,0"
                                     AutomationProperties.Name="CPU usage history" />
                </StackPanel>
            </Border>
            <!-- Memory -->
            <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="16,14">
                <StackPanel>
                    <DockPanel>
                        <Border Style="{StaticResource IconBadge}" Background="{StaticResource MemSoftBrush}" Width="30" Height="30">
                            <TextBlock Text="&#xE964;" Style="{StaticResource Icon}" FontSize="15" Foreground="{StaticResource MemBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Memory" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Main.VmMemText}" Style="{StaticResource StatValue}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding Main.VmMemSubText}" Style="{StaticResource Hint}" />
                    <infra:Sparkline Values="{Binding Main.VmMemHistory}" Stroke="{StaticResource MemBrush}" Height="38" Margin="0,10,0,0"
                                     AutomationProperties.Name="Memory usage history" />
                </StackPanel>
            </Border>
            <!-- Machines -->
            <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="16,14">
                <StackPanel>
                    <DockPanel>
                        <Border Style="{StaticResource IconBadge}" Background="{StaticResource AccentSoftBrush}" Width="30" Height="30">
                            <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="15" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Running" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Main.RunningText}" Style="{StaticResource StatValue}" Margin="0,10,0,0" />
                    <TextBlock Text="distributions running" Style="{StaticResource Hint}" />
                    <ItemsControl ItemsSource="{Binding Main.Distros}" Margin="0,14,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Ellipse Width="10" Height="10" Margin="0,0,6,6" Style="{StaticResource StatusDot}" ToolTip="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <!-- Swap -->
            <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="16,14">
                <StackPanel>
                    <DockPanel>
                        <Border Style="{StaticResource IconBadge}" Background="{StaticResource WarnSoftBrush}" Width="30" Height="30">
                            <TextBlock Text="&#xE8CB;" Style="{StaticResource Icon}" FontSize="15" Foreground="{StaticResource WarnBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Swap" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Main.VmSwapText}" Style="{StaticResource StatValue}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding Main.VmSwapSubText}" Style="{StaticResource Hint}" />
                    <ProgressBar Style="{StaticResource UsageBar}" Value="{Binding Main.VmSwapPercent, Mode=OneWay}" Foreground="{StaticResource WarnBrush}" Margin="0,22,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ===== Machines + inspector ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <DockPanel>
                <!-- column headings, aligned with the row template below -->
                <Grid DockPanel.Dock="Top" Margin="15,0,15,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" MinWidth="140" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="MACHINE" Style="{StaticResource ColHeader}" Margin="12,0,0,0" />
                    <TextBlock Grid.Column="2" Text="CPU" Style="{StaticResource ColHeader}" Margin="0,0,16,0" />
                    <TextBlock Grid.Column="3" Text="MEMORY" Style="{StaticResource ColHeader}" Margin="0,0,16,0" />
                    <TextBlock Grid.Column="4" Text="UPTIME" Style="{StaticResource ColHeader}" />
                </Grid>

                <Grid>
                    <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding Main.Distros}" SelectedItem="{Binding Selected}"
                             AutomationProperties.Name="Distributions">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid AutomationProperties.Name="{Binding Name}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" MinWidth="140" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>

                                    <!-- brand tile + status dot -->
                                    <Grid VerticalAlignment="Center">
                                        <ContentControl Style="{StaticResource BrandTile}" Content="{Binding Name}" />
                                        <Border Width="13" Height="13" CornerRadius="7" Background="{StaticResource CardBrush}"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3">
                                            <Ellipse Width="9" Height="9" Style="{StaticResource StatusDot}" />
                                        </Border>
                                    </Grid>

                                    <!-- name / subtitle -->
                                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <Border Style="{StaticResource Pill}" Background="{StaticResource SurfaceBrush}" Margin="8,0,0,0"
                                                    Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="9" VerticalAlignment="Center" Foreground="{StaticResource WarnBrush}" />
                                                    <TextBlock Text="default" FontSize="11" Margin="4,0,0,0" Foreground="{StaticResource TextMutedBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Margin="0,3,0,0" FontSize="12" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding State, Mode=OneWay}" />
                                            <Run Text="  ·  " Foreground="{StaticResource TextSubtleBrush}" /><Run Text="{Binding Subtitle, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource StateText}"><Setter Property="FontWeight" Value="Normal" /></Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- CPU -->
                                    <Grid Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <DockPanel>
                                            <TextBlock Text="{Binding CpuText}" FontWeight="SemiBold" Width="52" VerticalAlignment="Bottom" />
                                            <infra:Sparkline Values="{Binding CpuHistory}" Stroke="{StaticResource CpuBrush}" Height="22" Maximum="0"
                                                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                        </DockPanel>
                                        <ProgressBar Grid.Row="1" Style="{StaticResource UsageBar}" Foreground="{StaticResource CpuBrush}" Margin="0,5,0,0"
                                                     Value="{Binding CpuPercent, Mode=OneWay, TargetNullValue=0}" />
                                    </Grid>

                                    <!-- Memory -->
                                    <Grid Grid.Column="3" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <DockPanel>
                                            <TextBlock Text="{Binding MemText}" FontWeight="SemiBold" Width="64" VerticalAlignment="Bottom" />
                                            <infra:Sparkline Values="{Binding MemHistory}" Stroke="{StaticResource MemBrush}" Height="22" Maximum="100"
                                                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                        </DockPanel>
                                        <ProgressBar Grid.Row="1" Style="{StaticResource UsageBar}" Foreground="{StaticResource MemBrush}" Margin="0,5,0,0"
                                                     Value="{Binding MemPercent, Mode=OneWay, TargetNullValue=0}" />
                                    </Grid>

                                    <!-- Uptime -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource TextSubtleBrush}" />
                                        <TextBlock Text="{Binding UptimeText}" Margin="6,0,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="12.5" />
                                    </StackPanel>

                                    <!-- Quick actions -->
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Style="{StaticResource PowerButton}" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.RowPowerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE756;" CommandParameter="{Binding}" ToolTip="Open terminal" AutomationProperties.Name="Open terminal"
                                                Command="{Binding DataContext.RowTerminalCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE8B7;" CommandParameter="{Binding}" ToolTip="Browse Linux files" AutomationProperties.Name="Browse Linux files"
                                                Command="{Binding DataContext.RowFilesCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Main.HasDistros, Converter={StaticResource InvBoolToVis}}">
                        <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="40" HorizontalAlignment="Center" Foreground="{StaticResource TextSubtleBrush}" />
                        <TextBlock Text="No distributions yet" Style="{StaticResource SectionHeader}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Text="Install one from the catalog to get started." Style="{StaticResource Hint}" HorizontalAlignment="Center" />
                        <Button Style="{StaticResource AccentIconTextButton}" infra:Ui.Icon="&#xE896;" Content="Browse catalog" Command="{Binding InstallNewCommand}"
                                HorizontalAlignment="Center" Margin="0,16,0,0" />
                    </StackPanel>
                </Grid>
            </DockPanel>

            <!-- ===== Inspector ===== -->
            <ScrollViewer Grid.Column="1" Margin="18,0,0,0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <Grid>
                    <Border Style="{StaticResource Card}" Visibility="{Binding HasSelection, Converter={StaticResource InvBoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" Margin="0,30">
                            <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="28" HorizontalAlignment="Center" Foreground="{StaticResource TextSubtleBrush}" />
                            <TextBlock Text="Select a machine to manage it" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <!-- Identity + facts -->
                        <Border Style="{StaticResource Card}" DataContext="{Binding Selected}">
                            <StackPanel>
                                <DockPanel>
                                    <ContentControl Style="{StaticResource BrandTile}" Content="{Binding Name}" Width="48" Height="48" FontSize="17" />
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Border Style="{StaticResource StatePill}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Style="{StaticResource StatusDot}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding State}" Style="{StaticResource StateText}" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center">
                                                WSL <Run Text="{Binding Version, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.Resources>
                                        <Style TargetType="TextBlock" x:Key="K" BasedOn="{StaticResource Hint}"><Setter Property="Margin" Value="0,5" /><Setter Property="FontSize" Value="12.5" /></Style>
                                        <Style TargetType="TextBlock" x:Key="I" BasedOn="{StaticResource Icon}"><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="{StaticResource TextSubtleBrush}" /><Setter Property="VerticalAlignment" Value="Top" /><Setter Property="Margin" Value="0,6,0,0" /></Style>
                                    </Grid.Resources>

                                    <TextBlock Grid.Row="0" Text="&#xE7F4;" Style="{StaticResource I}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="OS" Style="{StaticResource K}" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding OsName, TargetNullValue='—', FallbackValue='—'}" Margin="0,5" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="1" Text="&#xE950;" Style="{StaticResource I}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Kernel" Style="{StaticResource K}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Kernel}" Margin="0,5" TextWrapping="Wrap" FontSize="12.5" />

                                    <TextBlock Grid.Row="2" Text="&#xE77B;" Style="{StaticResource I}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Default user" Style="{StaticResource K}" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,5">
                                        <Run Text="{Binding DefaultUser, Mode=OneWay}" /><Run Text="  uid " Foreground="{StaticResource TextSubtleBrush}" /><Run Text="{Binding DefaultUid, Mode=OneWay}" Foreground="{StaticResource TextSubtleBrush}" />
                                    </TextBlock>

                                    <TextBlock Grid.Row="3" Text="&#xEDA2;" Style="{StaticResource I}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Disk" Style="{StaticResource K}" />
                                    <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,5">
                                        <TextBlock Text="{Binding DiskSummary}" TextWrapping="Wrap" FontSize="12.5" />
                                        <ProgressBar Style="{StaticResource UsageBar}" Value="{Binding DiskPercent, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"
                                                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="4" Text="&#xE8B7;" Style="{StaticResource I}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Location" Style="{StaticResource K}" />
                                    <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding BasePath, Mode=OneWay}" Style="{StaticResource ValueText}" Margin="0,5"
                                             FontSize="12" Foreground="{StaticResource TextMutedBrush}" ToolTip="{Binding Guid}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Actions -->
                        <Border Style="{StaticResource Card}" Padding="12,16">
                            <StackPanel>
                                <UniformGrid Columns="3" Margin="4,0,4,14">
                                    <Button Style="{StaticResource AccentIconTextButton}" infra:Ui.Icon="&#xE768;" Content="Start" Command="{Binding StartCommand}" Margin="0,0,6,0" HorizontalAlignment="Stretch" />
                                    <Button Style="{StaticResource IconTextButton}" infra:Ui.Icon="&#xE71A;" Content="Stop" Command="{Binding StopCommand}" Margin="3,0" HorizontalAlignment="Stretch" />
                                    <Button Style="{StaticResource IconTextButton}" infra:Ui.Icon="&#xE72C;" Content="Restart" Command="{Binding RestartCommand}" Margin="6,0,0,0" HorizontalAlignment="Stretch" />
                                </UniformGrid>

                                <TextBlock Text="OPEN" Style="{StaticResource SectionLabel}" Margin="10,4,0,4" />
                                <Button Style="{StaticResource ActionRow}" infra:Ui.Icon="&#xE756;" Content="Terminal" Tag="Shell as the default user" Command="{Binding TerminalCommand}" />
                                <Button Style="{StaticResource ActionRow}" infra:Ui.Icon="&#xE7EF;" Content="Terminal as root" Command="{Binding RootTerminalCommand}" />
                                <Button Style="{StaticResource ActionRow}" infra:Ui.Icon="&#xE8B7;" Content="Linux files" Tag="Opens \\wsl.localhost in Explorer" Command="{Binding ExplorerCommand}" />
                                <Button Style="{StaticResource ActionRow}" infra:Ui.Icon="&#xE838;" Content="Install folder" Tag="Where the virtual disk lives on Windows" Command="{Binding InstallFolderCommand}" />
                                <Button Style="{StaticResource ActionRow}" infra:Ui.Icon="&#xE943;" Content="Run a command" Command="{Binding ConsoleCommand}" />

                                <TextBlock Text="CONFIGURE" Style="{StaticResource SectionLabel}" Margin="10,14,0,4" />
                                <Button Style="{StaticResource ActionRow}" infra:Ui.Icon="&#xE734;" Content="Make default" Tag="Used when you run plain `wsl`" Command="{Binding SetDefaultCommand}" />
                                <Button Style="{StaticResource ActionRow}" infra:Ui.Icon="&#xE77B;" Content="Default user" Command="{Binding SetDefaultUserCommand}" />
                                <Button Style="{StaticResource ActionRow}" infra:Ui.Icon="&#xE8FA;" Content="Create user" Command="{Binding CreateUserCommand}" />
                                <Button Style="{StaticResource ActionRow}" infra:Ui.Icon="&#xE9E9;" Content="Edit wsl.conf" Tag="systemd, automount, hostname, interop…" Command="{Binding EditConfCommand}" />
                                <Button Style="{StaticResource ActionRow}" infra:Ui.Icon="&#xE8AB;" Content="Convert WSL version" Tag="Switch between WSL 1 and WSL 2" Command="{Binding SetVersionCommand}" />

                                <TextBlock Text="STORAGE &amp; BACKUP" Style="{StaticResource SectionLabel}" Margin="10,14,0,4" />
                                <Button Style="{StaticResource ActionRow}" infra:Ui.Icon="&#xE898;" Content="Export" Tag="Save to a .tar or .vhdx file" Command="{Binding ExportCommand}" />
                                <Button Style="{StaticResource ActionRow}" infra:Ui.Icon="&#xE8C8;" Content="Clone" Tag="Independent copy under a new name" Command="{Binding CloneCommand}" />
                                <Button Style="{StaticResource ActionRow}" infra:Ui.Icon="&#xE8DE;" Content="Move" Tag="Relocate the virtual disk to another folder" Command="{Binding MoveCommand}" />
                                <Button Style="{StaticResource ActionRow}" infra:Ui.Icon="&#xE740;" Content="Resize disk" Command="{Binding ResizeCommand}" />
                                <Button Style="{StaticResource ActionRow}" infra:Ui.Icon="&#xE81E;" Content="Sparse disk" Tag="Give freed space back to Windows automatically" Command="{Binding SparseCommand}" />

                                <TextBlock Text="DANGER ZONE" Style="{StaticResource SectionLabel}" Margin="10,14,0,4" Foreground="{StaticResource DangerBrush}" />
                                <Button Style="{StaticResource ActionRow}" infra:Ui.Icon="&#xE74D;" Content="Unregister" Tag="Permanently deletes the distro and its disk"
                                        Command="{Binding UnregisterCommand}" Foreground="{StaticResource DangerBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
