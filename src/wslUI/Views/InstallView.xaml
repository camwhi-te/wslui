<UserControl x:Class="wslUI.Views.InstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:wslUI.Infrastructure">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" infra:Ui.ChildMargin="8,0,0,0">
                <Button Style="{StaticResource IconTextButton}" infra:Ui.Icon="&#xE8E5;" Content="Install from file…" Command="{Binding InstallFromFileCommand}"
                        ToolTip="Install a .wsl or .tar image from disk (wsl --install --from-file)" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Install a distribution" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Pick a Linux distribution from the official catalog, then choose a user for it." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </DockPanel>

        <!-- Search -->
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding LoadOnlineCommand}" ToolTip="Reload catalog" AutomationProperties.Name="Reload catalog" Margin="6,0,0,0" />
            <CheckBox DockPanel.Dock="Right" Content="Legacy catalog" IsChecked="{Binding Legacy}" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="Show the older distro manifest (--legacy)" />
            <Grid>
                <TextBox x:Name="Search" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Padding="34,7,10,7" AutomationProperties.Name="Search catalog" />
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Margin="12,0,0,0" Foreground="{StaticResource TextSubtleBrush}" IsHitTestVisible="False" />
                <TextBlock Text="Search distributions…" Margin="35,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSubtleBrush}" IsHitTestVisible="False"
                           Visibility="{Binding Filter, Converter={StaticResource InvBoolToVis}}" />
            </Grid>
        </DockPanel>

        <!-- Catalog grid -->
        <Grid Grid.Row="2">
            <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding OnlineView}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Catalog">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top" /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource CardItem}">
                        <Setter Property="Margin" Value="0,0,10,10" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel AutomationProperties.Name="{Binding FriendlyName}">
                            <ContentControl Style="{StaticResource BrandTile}" Content="{Binding Name}" Width="38" Height="38" FontSize="13" />
                            <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top"
                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Installed" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                            <StackPanel Margin="12,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Name}" FontSize="11.5" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSubtleBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Height="3" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding OnlineError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" VerticalAlignment="Bottom"
                       Visibility="{Binding OnlineError, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- Install panel -->
        <ScrollViewer Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Margin="18,0,0,0" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <!-- Nothing selected -->
                    <StackPanel Visibility="{Binding Selected, Converter={StaticResource InvBoolToVis}}" Margin="0,24" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="30" HorizontalAlignment="Center" Foreground="{StaticResource TextSubtleBrush}" />
                        <TextBlock Text="Choose a distribution from the catalog" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding Selected, Converter={StaticResource BoolToVis}}">
                        <DockPanel Margin="0,0,0,18">
                            <ContentControl Style="{StaticResource BrandTile}" Content="{Binding Selected.Name}" Width="48" Height="48" FontSize="17" />
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Selected.FriendlyName}" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Selected.Name}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextSubtleBrush}" />
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Text="Name  (optional)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Distribution name" />
                        <TextBlock Text="Give it a custom name to install the same distro more than once." Style="{StaticResource Hint}" Margin="0,5,0,16" />

                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CreateUser}">
                            <StackPanel>
                                <TextBlock Text="Create my Linux user now" />
                                <TextBlock Text="Skips the first-run prompt. Added to sudo/wheel." Style="{StaticResource Hint}" />
                            </StackPanel>
                        </CheckBox>
                        <StackPanel Visibility="{Binding CreateUser, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                            <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" AutomationProperties.Name="Username" />
                            <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="Pwd" PasswordChanged="Pwd_PasswordChanged" AutomationProperties.Name="Password" />
                        </StackPanel>

                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding OpenTerminalAfter}" Content="Open a terminal when finished" Margin="0,14,0,0" />

                        <Expander Header="Advanced options" Margin="0,14,0,0" HorizontalAlignment="Stretch">
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Install folder" Style="{StaticResource FieldLabel}" />
                                <DockPanel Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right" Content="&#xE838;" FontFamily="{StaticResource IconFont}" Command="{Binding BrowseLocationCommand}" Margin="8,0,0,0"
                                            ToolTip="Browse" AutomationProperties.Name="Browse install folder" Padding="12,6" />
                                    <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Install folder" />
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="WSL version" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding Version}" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Max disk size" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding VhdSize, UpdateSourceTrigger=PropertyChanged}" ToolTip="e.g. 256GB" AutomationProperties.Name="Max disk size" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Fixed-size disk" IsChecked="{Binding FixedVhd}" Margin="0,12,0,0" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Download from the web instead of the Store" IsChecked="{Binding WebDownload}" />
                            </StackPanel>
                        </Expander>

                        <Button Style="{StaticResource AccentIconTextButton}" infra:Ui.Icon="&#xE896;" Content="Install" Command="{Binding InstallCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,20,0,0" Padding="0,10" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" Margin="0,10,0,0" HorizontalAlignment="Center"
                                   Visibility="{Binding Status, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
