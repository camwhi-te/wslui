<UserControl x:Class="wslUI.Views.InstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:wslUI.Infrastructure">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="460" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2">
            <TextBlock Text="Install a distribution" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Pick from the online catalog (wsl --list --online) or install from a local .wsl / .tar file." Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <!-- Catalog -->
        <DockPanel Grid.Row="1">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Reload" Command="{Binding LoadOnlineCommand}" Margin="8,0,0,0" />
                <CheckBox DockPanel.Dock="Right" Content="Legacy catalog" IsChecked="{Binding Legacy}" Margin="8,0,0,0" ToolTip="--legacy" />
                <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter" />
            </DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding OnlineError}" Foreground="#E5484D" TextWrapping="Wrap"
                       Visibility="{Binding OnlineError, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0" />
            <Grid>
                <DataGrid ItemsSource="{Binding OnlineView}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="44">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Friendly name" Binding="{Binding FriendlyName}" Width="*" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CellText}" />
                    </DataGrid.Columns>
                </DataGrid>
                <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Height="3"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DockPanel>

        <!-- Options -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}">
                            <Run Text="Install " /><Run Text="{Binding Selected.FriendlyName, Mode=OneWay, FallbackValue='(select a distro)', TargetNullValue='(select a distro)'}" />
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" ToolTip="--name (optional; lets you install the same distro twice)" />
                            <TextBlock Grid.Row="1" Text="Location" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" ToolTip="--location (optional)" />
                            <Button Grid.Row="1" Grid.Column="2" Content="…" Command="{Binding BrowseLocationCommand}" Margin="6,0,0,8" />
                            <TextBlock Grid.Row="2" Text="WSL version" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Versions}" SelectedItem="{Binding Version}" Margin="0,0,0,8" HorizontalAlignment="Left" Width="90" />
                            <TextBlock Grid.Row="3" Text="Disk size" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding VhdSize, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" ToolTip="--vhd-size, e.g. 256GB (optional)" />
                        </Grid>
                        <CheckBox Content="Fixed-size VHD (--fixed-vhd)" IsChecked="{Binding FixedVhd}" Margin="0,4" />
                        <CheckBox Content="Download from the internet, not the Store (--web-download)" IsChecked="{Binding WebDownload}" Margin="0,4" />

                        <Separator Margin="0,10" />
                        <CheckBox Content="Create a default user now" IsChecked="{Binding CreateUser}" Margin="0,4" />
                        <Grid Visibility="{Binding CreateUser, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Text="Password" Style="{StaticResource FieldLabel}" />
                            <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="Pwd" PasswordChanged="Pwd_PasswordChanged" Margin="0,0,0,8" />
                        </Grid>
                        <TextBlock Text="Otherwise the distro asks for a user the first time you open it in a terminal." Style="{StaticResource Hint}"
                                   Visibility="{Binding CreateUser, Converter={StaticResource InvBoolToVis}}" />
                        <CheckBox Content="Open a terminal when finished" IsChecked="{Binding OpenTerminalAfter}" Margin="0,8,0,4" />

                        <Button Command="{Binding InstallCommand}" Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Stretch" Margin="0,12,0,0" Padding="0,8">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource Icon}" /><TextBlock Text="Install" Margin="8,0,0,0" /></StackPanel>
                        </Button>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Install from file" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="Uses the name / location / version / user options above (wsl --install --from-file)." Style="{StaticResource Hint}" Margin="0,0,0,8" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseFileCommand}" Margin="6,0,0,0" />
                            <TextBox Text="{Binding FromFile, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <Button Content="Install from file" Command="{Binding InstallFromFileCommand}" Margin="0,10,0,0" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
