<UserControl x:Class="wslUI.Views.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:wslUI.Infrastructure">
    <DockPanel>
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" infra:Ui.ChildMargin="8,0,0,0">
                <Button Style="{StaticResource IconTextButton}" infra:Ui.Icon="&#xE8A7;" Content="Open in terminal" Command="{Binding TerminalCommand}"
                        ToolTip="Interactive shell in a real terminal window (for vim, top, etc.)" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Console" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Run commands inside a distribution, or pass any arguments straight to wsl.exe." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </DockPanel>

        <!-- Target -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,12">
            <DockPanel>
                <ListBox DockPanel.Dock="Left" Style="{StaticResource Segmented}" SelectedIndex="{Binding ModeIndex}" VerticalAlignment="Center" AutomationProperties.Name="Mode">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE756;" Style="{StaticResource Icon}" FontSize="12" /><TextBlock Text="Inside a distro" Margin="6,0,0,0" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE943;" Style="{StaticResource Icon}" FontSize="12" /><TextBlock Text="Raw wsl.exe" Margin="6,0,0,0" /></StackPanel>
                    </ListBoxItem>
                </ListBox>

                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" Visibility="{Binding RawMode, Converter={StaticResource InvBoolToVis}}">
                    <Grid VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding Main.Distros}" SelectedItem="{Binding SelectedDistro}" MinWidth="210" AutomationProperties.Name="Distribution">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Style="{StaticResource BrandTile}" Content="{Binding Name}" Width="20" Height="20" FontSize="9" />
                                        <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Default distribution" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSubtleBrush}" IsHitTestVisible="False"
                                   Visibility="{Binding SelectedDistro, Converter={StaticResource InvBoolToVis}}" />
                    </Grid>
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" Click="UseDefault_Click" ToolTip="Use the default distribution" AutomationProperties.Name="Use default distribution"
                            Visibility="{Binding SelectedDistro, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="14" Margin="16,0,8,0" Foreground="{StaticResource TextMutedBrush}" />
                    <Grid VerticalAlignment="Center">
                        <TextBox Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" Width="140" AutomationProperties.Name="User" />
                        <TextBlock Text="default user" Margin="11,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSubtleBrush}" IsHitTestVisible="False"
                                   Visibility="{Binding User, Converter={StaticResource InvBoolToVis}}" />
                    </Grid>
                </StackPanel>
                <TextBlock Text="Everything you type is passed to wsl.exe as-is, e.g.  --list --verbose  or  -d Debian -- uname -a"
                           Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="18,0,0,0" Visibility="{Binding RawMode, Converter={StaticResource BoolToVis}}" />
            </DockPanel>
        </Border>

        <!-- Command line -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" Command="{Binding ClearCommand}" ToolTip="Clear output" AutomationProperties.Name="Clear output" Margin="6,0,0,0" />
            <Button DockPanel.Dock="Right" Style="{StaticResource IconTextButton}" infra:Ui.Icon="&#xE71A;" Content="Stop" Command="{Binding StopCommand}" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Style="{StaticResource AccentIconTextButton}" infra:Ui.Icon="&#xE768;" Content="Run" Command="{Binding RunCommand}" Margin="8,0,0,0" MinWidth="90" />
            <Border Background="{StaticResource NavBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Prompt}" FontFamily="{StaticResource MonoFont}" FontSize="14" Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center" Margin="12,0,4,0" />
                    <ComboBox ItemsSource="{Binding History}" Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" BorderThickness="0" Background="Transparent"
                              FontFamily="{StaticResource MonoFont}" ToolTip="Enter to run · arrow for history" AutomationProperties.Name="Command">
                        <ComboBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding RunCommand}" />
                        </ComboBox.InputBindings>
                    </ComboBox>
                </DockPanel>
            </Border>
        </DockPanel>

        <!-- stdin -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
            <TextBlock DockPanel.Dock="Left" Text="&#xE765;" Style="{StaticResource Icon}" Margin="0,0,10,0" Foreground="{StaticResource TextMutedBrush}" ToolTip="Send input to the running command" />
            <Button DockPanel.Dock="Right" Style="{StaticResource IconTextButton}" infra:Ui.Icon="&#xE724;" Content="Send" Command="{Binding SendCommand}" Margin="8,0,0,0" />
            <Grid>
                <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Input">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SendCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="Type input for the running command and press Enter" Margin="11,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSubtleBrush}"
                           IsHitTestVisible="False" Visibility="{Binding Input, Converter={StaticResource InvBoolToVis}}" />
            </Grid>
        </DockPanel>

        <!-- Output -->
        <Border Background="{StaticResource NavBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <TextBox x:Name="OutputBox" Text="{Binding Output, Mode=OneWay}" Style="{StaticResource Mono}" FontSize="13" Background="Transparent" BorderThickness="0"
                         Padding="12,10" TextChanged="OutputBox_TextChanged" AutomationProperties.Name="Output" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                            Visibility="{Binding Output, Converter={StaticResource InvBoolToVis}}">
                    <TextBlock Text="&#xE756;" Style="{StaticResource Icon}" FontSize="30" HorizontalAlignment="Center" Foreground="{StaticResource TextSubtleBrush}" />
                    <TextBlock Text="Output appears here" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
