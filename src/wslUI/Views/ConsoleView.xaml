<UserControl x:Class="wslUI.Views.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:wslUI.Infrastructure">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Console" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Run a command inside a distro and see its output here — or tick “Raw wsl.exe” to pass any arguments straight to wsl.exe. Full-screen programs (vim, top) need a real terminal." />
        </StackPanel>

        <!-- Target -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Distribution" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding Main.Distros}" SelectedItem="{Binding SelectedDistro}" DisplayMemberPath="Name" MinWidth="180"
                      IsEnabled="{Binding RawMode, Converter={StaticResource Not}}" />
            <Button Content="Use default" Click="UseDefault_Click" Margin="6,0,20,0" Padding="8,4"
                    IsEnabled="{Binding RawMode, Converter={StaticResource Not}}" />
            <TextBlock Text="User" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" Width="120" ToolTip="Blank = distro's default user"
                     IsEnabled="{Binding RawMode, Converter={StaticResource Not}}" />
            <CheckBox Content="Raw wsl.exe arguments" IsChecked="{Binding RawMode}" Margin="20,0,0,0" VerticalAlignment="Center" />
            <Button Content="Open in terminal" Command="{Binding TerminalCommand}" Margin="20,0,0,0" />
        </WrapPanel>

        <!-- Command line -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Left" Text="{Binding Prompt}" FontFamily="{StaticResource MonoFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearCommand}" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Stop" Command="{Binding StopCommand}" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Run" Command="{Binding RunCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="8,0,0,0" MinWidth="80" />
            <ComboBox ItemsSource="{Binding History}" Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"
                      FontFamily="{StaticResource MonoFont}" ToolTip="Enter to run · dropdown for history">
                <ComboBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding RunCommand}" />
                </ComboBox.InputBindings>
            </ComboBox>
        </DockPanel>

        <!-- stdin -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
            <TextBlock DockPanel.Dock="Left" Text="stdin" VerticalAlignment="Center" Margin="0,0,10,0" Style="{StaticResource Hint}" />
            <Button DockPanel.Dock="Right" Content="Send" Command="{Binding SendCommand}" Margin="8,0,0,0" />
            <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SendCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>

        <TextBox x:Name="OutputBox" Text="{Binding Output, Mode=OneWay}" Style="{StaticResource Mono}" FontSize="13" TextChanged="OutputBox_TextChanged" />
    </DockPanel>
</UserControl>
