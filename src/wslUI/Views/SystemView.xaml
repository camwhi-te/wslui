<UserControl x:Class="wslUI.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:wslUI.Infrastructure">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

            <StackPanel Grid.ColumnSpan="2">
                <TextBlock Text="System" Style="{StaticResource PageTitle}" />
                <TextBlock Text="WSL itself: version, updates, VM control, defaults and wslUI's own settings." Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,8,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" />
                            <TextBlock Text="Version (wsl --version)" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBox Text="{Binding VersionText, Mode=OneWay}" Style="{StaticResource Mono}" MinHeight="120" />
                        <TextBlock Text="Status (wsl --status)" Style="{StaticResource SectionHeader}" Margin="0,14,0,8" />
                        <TextBox Text="{Binding StatusText, Mode=OneWay}" Style="{StaticResource Mono}" MinHeight="60" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Update" Style="{StaticResource SectionHeader}" />
                        <WrapPanel infra:Ui.ChildMargin="0,0,8,8">
                            <Button Content="Update WSL" Command="{Binding UpdateCommand}" Style="{DynamicResource AccentButtonStyle}" />
                            <Button Content="Update to pre-release" Command="{Binding UpdatePreCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="WSL VM" Style="{StaticResource SectionHeader}" />
                        <WrapPanel infra:Ui.ChildMargin="0,0,8,8">
                            <Button Content="Shut down" Command="{Binding ShutdownCommand}" />
                            <Button Content="Force shut down" Command="{Binding ForceShutdownCommand}" />
                            <Button Content="Debug shell" Command="{Binding DebugShellCommand}" ToolTip="wsl --debug-shell" />
                            <Button Content="System distro shell" Command="{Binding SystemShellCommand}" ToolTip="wsl --system" />
                            <Button Content="WSL Settings app" Command="{Binding WslSettingsCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Default version for new distributions" Style="{StaticResource SectionHeader}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8">
                            Current: WSL <Run Text="{Binding DefaultVersion, Mode=OneWay}" />
                        </TextBlock>
                        <WrapPanel infra:Ui.ChildMargin="0,0,8,0">
                            <Button Content="Use WSL 2" Command="{Binding SetDefaultVersionCommand}" CommandParameter="2" />
                            <Button Content="Use WSL 1" Command="{Binding SetDefaultVersionCommand}" CommandParameter="1" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Components" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="Install the optional Windows components WSL needs without installing a distribution (wsl --install --no-distribution)." Style="{StaticResource Hint}" Margin="0,0,0,8" />
                        <CheckBox Content="Also enable WSL 1 support (--enable-wsl1)" IsChecked="{Binding EnableWsl1}" Margin="0,0,0,8" />
                        <WrapPanel infra:Ui.ChildMargin="0,0,8,8">
                            <Button Content="Install components" Command="{Binding InstallComponentsCommand}" />
                            <Button Content="Uninstall WSL…" Command="{Binding UninstallCommand}" Foreground="#E5484D" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="wslUI settings" Style="{StaticResource SectionHeader}" />
                        <CheckBox Content="Closing the window minimizes to the tray" IsChecked="{Binding CloseToTray}" Margin="0,4" />
                        <CheckBox Content="Start minimized to the tray" IsChecked="{Binding StartMinimized}" Margin="0,4" />
                        <CheckBox Content="Live stats for running distros (disk, processes, VM memory)" IsChecked="{Binding LiveStats}" Margin="0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Stats interval (seconds)" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox Text="{Binding StatsInterval, UpdateSourceTrigger=LostFocus}" Width="70" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="Live stats run a tiny command in each running distro while the window is visible. That counts as activity, so distros won't idle-stop while you watch them." />
                        <Button Content="Open settings folder" Command="{Binding OpenSettingsFolderCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
