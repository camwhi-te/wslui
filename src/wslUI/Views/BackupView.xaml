<UserControl x:Class="wslUI.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:wslUI.Infrastructure">
    <UserControl.Resources>
        <!-- Large clickable action card: Ui.Icon = glyph, Content = title, Tag = description -->
        <Style x:Key="ActionCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
                            <StackPanel>
                                <Border Width="46" Height="46" CornerRadius="11" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left">
                                    <TextBlock Text="{TemplateBinding infra:Ui.Icon}" FontFamily="{StaticResource IconFont}" FontSize="20"
                                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ContentPresenter Margin="0,16,0,6" TextElement.FontSize="16" TextElement.FontWeight="SemiBold" />
                                <TextBlock Text="{TemplateBinding Tag}" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <TextBlock Text="Start" Foreground="{StaticResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                    <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="6,1,0,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Backup &amp; import" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Move distributions between files and machines. Each action walks you through the few choices it needs." Style="{StaticResource PageSubtitle}" />

            <UniformGrid Columns="3" Margin="0,22,-14,0" VerticalAlignment="Top">
                <Button Style="{StaticResource ActionCard}" infra:Ui.Icon="&#xE898;" Content="Export"
                        Tag="Save a distribution to a .tar archive or .vhdx disk — a full backup you can restore anywhere."
                        Command="{Binding ExportCommand}" />
                <Button Style="{StaticResource ActionCard}" infra:Ui.Icon="&#xE896;" Content="Import"
                        Tag="Create a new distribution from a .tar archive or a copy of a .vhdx disk."
                        Command="{Binding ImportCommand}" />
                <Button Style="{StaticResource ActionCard}" infra:Ui.Icon="&#xE8F4;" Content="Register existing disk"
                        Tag="Use a .vhdx where it already is, without copying it (import in place)."
                        Command="{Binding ImportInPlaceCommand}" />
            </UniformGrid>

            <Border Style="{StaticResource Card}" Margin="0,4,0,0" Visibility="{Binding LastResult, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding LastResult}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}" Background="Transparent" Margin="0,4,0,0">
                <DockPanel>
                    <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{StaticResource CpuBrush}" Margin="0,0,12,0" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Text="Tip" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" FontSize="12.5"
                                   Text="To duplicate a distribution on this PC, select it on the Overview page and use Clone." />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
