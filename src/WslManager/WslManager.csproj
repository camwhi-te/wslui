<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WslManager</AssemblyName>
    <RootNamespace>WslManager</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>WSL Manager</Product>
    <!-- WPF Fluent theme (ThemeMode) is still flagged experimental -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>

    <!-- Single self-contained exe on `dotnet publish` -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
  </PropertyGroup>

  <!-- Dev-only: build with -p:NoElevate=true to run without a UAC prompt -->
  <PropertyGroup Condition="'$(NoElevate)' == 'true'">
    <ApplicationManifest>app.noelevate.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms both enabled (WinForms only for the tray icon); avoid type clashes -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
